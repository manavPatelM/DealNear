# Copy to terraform.tfvars (git-ignored) and adjust.
region        = "ap-south-1"
environment   = "demo"
instance_type = "t3.medium"
repo_url      = "https://github.com/manavPatelM/DealNear.git"
repo_branch   = "main"

# Optional: set after you own a domain; then point its A record at the output public_ip.
domain_name = ""

admin_email  = "admin@dealnear.local"
budget_email = "you@example.com"
monthly_budget_usd = 50

# AWS Academy Learner Lab: use region "us-east-1" and the lab-provided profile.
# existing_instance_profile = "LabInstanceProfile"
